# Docker ignore file to reduce build context size

# Rust build artifacts
target/
**/.cargo/registry/
**/.cargo/git/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Environment files (will be passed as env vars)
.env
.env.local
.env.*.local

# Documentation that's not needed in container
docs/
*.md
!README.md

# Git
.git/
.gitignore

# Testing
.coverage
coverage/

# Logs
*.log

# Node modules (if any)
node_modules/

# Docker files themselves
Dockerfile*
docker-compose*.yml
.dockerignore