# Database Connection
# For local development, use a local MySQL instance:
# DATABASE_URL="mysql://user:password@localhost:3306/data_commons"
# 
# For PlanetScale production:
# DATABASE_URL="mysql://username:password@host.psdb.cloud/database-name"
DATABASE_URL="mysql://user:password@localhost:3306/data_commons"

# Dash0 Telemetry Configuration
# Get these values from your Dash0 organization settings
# Example endpoints by region:
# - EU: https://otel.eu-west-1.aws.dash0.com:4317
# - US: https://otel.us-east-1.aws.dash0.com:4317
DASH0_OTLP_ENDPOINT="https://otel.eu-west-1.aws.dash0.com:4317"
DASH0_AUTH_TOKEN="your-dash0-auth-token-here"

# Service Configuration
SERVICE_VERSION="0.1.0"
DEPLOYMENT_ENVIRONMENT="development"

# Telemetry Feature Flags
ENABLE_METRICS="true"
ENABLE_TRACES="true"
ENABLE_LOGS="true"

# Application Configuration (optional - these have defaults in config.toml)
# APP_SERVER_HOST="127.0.0.1"
# APP_SERVER_PORT="3000"
# APP_LOGGING_LEVEL="info"
RUST_LOG="info"